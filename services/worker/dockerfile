FROM golang:1.24-alpine AS builder


WORKDIR /app

COPY go.mod ./

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o worker

# second stage 

FROM alpine:3.21

WORKDIR /app


COPY --from=builder /app/worker ./worker


RUN adduser -D appuser \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE 8081

CMD ["./worker"]